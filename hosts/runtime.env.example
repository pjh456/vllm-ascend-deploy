# 复制为 hosts/<host>/runtime.env。
# 这里放加速器/镜像相关的环境变量，不属于 vLLM CLI 参数。
# 由 BIND_IP、NIC 派生的 HCCL_IF_IP / *_SOCKET_IFNAME 不在此重复。

HCCL_BUFFSIZE=512
HCCL_EXEC_TIMEOUT=1200
HCCL_CONNECT_TIMEOUT=600
HCCL_OP_EXPANSION_MODE=AIV
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=3000

TASK_QUEUE_ENABLE=1
CPU_AFFINITY_CONF=1
ASCEND_LAUNCH_BLOCKING=0
PYTORCH_NPU_ALLOC_CONF=expandable_segments:True

# 单实例大模型（例如 Qwen3.8-Flash-Next）建议放开引擎就绪/执行超时：
# VLLM_ENGINE_READY_TIMEOUT_S=4800
# VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=3000

# 可选：把镜像内的 vllm-ascend 固定到指定 fork 分支
# 镜像自带的 commit 与你的 fork 不一致时（典型症状：DFlash2 / aclgraph 相关断言），
# 取消注释并填好；不设置则直接使用镜像版本。
# VLLM_ASCEND_REPO=https://github.com/<you>/vllm-ascend.git
# VLLM_ASCEND_BRANCH=deploy/xxx
# VLLM_ASCEND_FETCH_PROXY=http://proxy:port
