# 复制为 hosts/<host>/.env 后填写。
#
# 参数生成约定（见 engine/build_args.sh）：
#   COMMON_FOO_BAR=value  -> --foo-bar value（P/D/单实例共享）
#   P_FOO_BAR=value       -> --foo-bar value（仅 prefill，覆盖 COMMON_）
#   D_FOO_BAR=value       -> --foo-bar value（仅 decode，覆盖 COMMON_）
#   S_FOO_BAR=value       -> --foo-bar value（仅单实例，覆盖 COMMON_）
#   true / false          -> 加 / 不加裸 flag
#   @/path/to/file        -> 参数值从文件读取（JSON 用）
#
# 不以下列前缀开头的变量只作配置，不会变成 CLI 参数。

HOST_ID=__HOST__
# compose 项目名不能含点号；init.sh 会把主机名里的 . 换成 -
COMPOSE_PROJECT_NAME=vllm-__HOST__

# 部署模式：pd = Prefill/Decode 分离；single = 单实例聚合（直接暴露 OpenAI API）
STACK_MODE=pd

# 对外绑定地址与 HCCL 网卡
BIND_IP=__BIND_IP__
NIC=__NIC__

# 端口
P_PORT=8100
D_PORT=8200
ROUTER_PORT=8080
METRICS_PORT=29000

# 挂载根目录（容器内路径与宿主保持一致）
MODEL_ROOT=__MODEL_ROOT__
CACHE_ROOT=__CACHE_ROOT__

# 模型与投机解码（供脚本拼装 JSON，不是直接参数）
#   外部 draft：DRAFT=/path，SPEC_METHOD=dflash
#   模型自带 MTP：DRAFT 留空，SPEC_METHOD=qwen3_5_mtp（可选 SPEC_ENFORCE_EAGER=false）
MODEL=__MODEL_PATH__
DRAFT=
SPEC_TOKENS=6
SPEC_METHOD=dflash

# ---- P/D 共享参数 ----
COMMON_SERVED_NAME=__SERVED_NAME__
COMMON_HOST=0.0.0.0
COMMON_TP=4
COMMON_ENABLE_EP=false
COMMON_MAX_MODEL_LEN=262144
COMMON_MAX_NUM_SEQS=32
COMMON_BLOCK_SIZE=128
COMMON_PREFIX_RETENTION=3072
COMMON_TOOL_PARSER=qwen3_coder
COMMON_REASONING_PARSER=qwen3
COMMON_QUANTIZATION=ascend
COMMON_DATA_PARALLEL_SIZE=1
COMMON_ENABLE_CHUNKED_PREFILL=true
COMMON_ENABLE_PREFIX_CACHING=true
COMMON_ENABLE_PROMPT_TOKENS_DETAILS=true
COMMON_ENABLE_AUTO_TOOL_CHOICE=true
COMMON_ASYNC_SCHEDULING=true
COMMON_CHAT_TEMPLATE_KWARGS='{"enable_thinking": false}'
COMMON_MODEL_LOADER_CONFIG='{"enable_multithread_load": true, "num_threads": 64}'

# ---- P / D 差异 ----
# 容器内逻辑编号：映射 4 张卡时一律写 0,1,2,3；
# 物理卡由 hosts/<host>/host.yaml 的 devices 决定
P_NPUS=0,1,2,3
D_NPUS=0,1,2,3
P_GPU_MEMORY_UTILIZATION=0.85
D_GPU_MEMORY_UTILIZATION=0.90
P_MAX_NUM_BATCHED_TOKENS=8192
D_MAX_NUM_BATCHED_TOKENS=1536
P_CAPTURE_MODE=PIECEWISE
D_CAPTURE_MODE=FULL_DECODE_ONLY
P_API_SERVER_COUNT=1
P_KV_TRANSFER_CONFIG=@/opt/vllm/hosts/__HOST__/kv-p.json
D_KV_TRANSFER_CONFIG=@/opt/vllm/hosts/__HOST__/kv-d.json
P_ADDITIONAL_CONFIG=@/opt/vllm/hosts/__HOST__/p-additional.json
D_ADDITIONAL_CONFIG=@/opt/vllm/hosts/__HOST__/d-additional.json

# ---- 单实例（聚合）模式 ----
# STACK_MODE=single 时使用；S_ 前缀的变量会覆盖 COMMON_ 同名参数。
# 单实例没有 router，S_PORT 就是直接对外的 OpenAI 兼容端口。
S_PORT=8088
S_NPUS=0,1,2,3,4,5,6,7
S_GPU_MEMORY_UTILIZATION=0.90
S_MAX_NUM_SEQS=8
S_MAX_NUM_BATCHED_TOKENS=4096
S_CAPTURE_MODE=FULL_DECODE_ONLY
S_ADDITIONAL_CONFIG=@/opt/vllm/hosts/__HOST__/s-additional.json
# Engram/PLE 的 51B n-gram 表默认放宿主内存；不需要时把整行置空
S_ENGRAM_CONFIG=@/opt/vllm/hosts/__HOST__/engram.json

# ---- router（仅 PD 模式）----
# 以下键保留给 vllm-router；默认的 shim 不使用它们
KV_CONNECTOR=mooncake
KV_BOOTSTRAP_PORT=28000
ROUTER_PREFILL_POLICY=cache_aware
ROUTER_DECODE_POLICY=round_robin

# ---- 引擎与容器 ----
MMC_SHM_SIZE=820g
STOP_GRACE=120s
HEALTH_MAX_WAIT=30m
LOG_MAX_SIZE=100m
LOG_MAX_FILE=3
