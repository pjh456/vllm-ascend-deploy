# 复制为 hosts/<host>/.env 后填写。
# 带 __ 的值必须替换；其余可按机器调整。
# 这里只放标量；嵌套 JSON 放同目录的 *.json。

HOST_ID=__HOST__
COMPOSE_PROJECT_NAME=vllm-__HOST__

# 对外绑定地址与 HCCL 网卡
BIND_IP=__BIND_IP__
NIC=__NIC__

# 端口（四个必须互不相同）
P_PORT=8100
D_PORT=8200
ROUTER_PORT=8080
METRICS_PORT=29000

# 模型与挂载根目录（容器内路径与宿主保持一致）
MODEL_ROOT=__MODEL_ROOT__
CACHE_ROOT=__CACHE_ROOT__
MODEL=__MODEL_PATH__
DRAFT=
SERVED_NAME=__SERVED_NAME__

# 并行与上下文
TP=4
ENABLE_EP=0
P_NPUS=0,1,2,3
D_NPUS=4,5,6,7
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=32
SPEC_TOKENS=6
SPEC_METHOD=dflash
BLOCK_SIZE=128
PREFIX_RETENTION=3072

# Prefill 实例
P_CHUNK=8192
P_GMU=0.85
P_CAPTURE_MODE=PIECEWISE
P_API_SERVERS=1

# Decode 实例
D_CHUNK=1536
D_GMU=0.90
D_CAPTURE_MODE=FULL_DECODE_ONLY

# 解析器与模板
TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
CHAT_TEMPLATE_KWARGS='{"enable_thinking": false}'
MODEL_LOADER_CONFIG='{"enable_multithread_load": true, "num_threads": 64}'

# KV 连接器：mooncake 时第二参数为 bootstrap 端口；握手不可用则填 none
KV_CONNECTOR=mooncake
KV_BOOTSTRAP_PORT=28000
ROUTER_PREFILL_POLICY=cache_aware
ROUTER_DECODE_POLICY=power_of_two

# 引擎与容器
HCCL_BUFFSIZE=512
MMC_SHM_SIZE=820g
STOP_GRACE=120s
HEALTH_MAX_WAIT=30m
LOG_MAX_SIZE=100m
LOG_MAX_FILE=3
