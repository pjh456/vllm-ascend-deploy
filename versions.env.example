# 复制为 versions.env 后使用；升级只改这一个文件
#
# 建议把 VLLM_IMAGE 固定到 digest 以保证可复现：
#   VLLM_IMAGE=ascendai/vllm-ascend@sha256:xxxxxxxx
VLLM_IMAGE=ascendai/vllm-ascend:nightly-main-openeuler

# 保留：仅在使用 router/Dockerfile 的 vllm-router 时需要（当前默认用 shim）
ROUTER_IMAGE=vllm-router:0.1.17
ROUTER_VERSION=0.1.17

# 构建时可选的内网 pip 源
PIP_INDEX_URL=https://pypi.org/simple
